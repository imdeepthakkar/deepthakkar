{
  "version": 2,
  "name": "deepthakkar",
  "builds": [
    {
      "src": "api/proxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/greencart",
      "dest": "api/proxy.js"
    },
    {
      "src": "/greencart/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/luxtravel",
      "dest": "api/proxy.js"
    },
    {
      "src": "/luxtravel/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/ai-job-search",
      "dest": "api/proxy.js"
    },
    {
      "src": "/ai-job-search/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/github-repo-manager",
      "dest": "api/proxy.js"
    },
    {
      "src": "/github-repo-manager/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/portfolio",
      "dest": "api/proxy.js"
    },
    {
      "src": "/portfolio/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/java-interview",
      "dest": "api/proxy.js"
    },
    {
      "src": "/java-interview/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/rejseplannen",
      "dest": "api/proxy.js"
    },
    {
      "src": "/rejseplannen/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/java",
      "dest": "api/proxy.js"
    },
    {
      "src": "/java/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/scrum-master",
      "dest": "api/proxy.js"
    },
    {
      "src": "/scrum-master/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/scrum-scenarios",
      "dest": "api/proxy.js"
    },
    {
      "src": "/scrum-scenarios/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/weather",
      "dest": "api/proxy.js"
    },
    {
      "src": "/weather/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/system-design",
      "dest": "api/proxy.js"
    },
    {
      "src": "/system-design/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/profile",
      "dest": "api/proxy.js"
    },
    {
      "src": "/profile/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/personal-calendar",
      "dest": "api/proxy.js"
    },
    {
      "src": "/personal-calendar/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/personal-calander",
      "dest": "api/proxy.js"
    },
    {
      "src": "/personal-calander/(.*)",
      "dest": "api/proxy.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
